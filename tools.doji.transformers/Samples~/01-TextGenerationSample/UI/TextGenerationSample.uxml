<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:chat="Doji.AI.Transformers.Samples.TextGeneration" editor-extension-mode="False">
    <Style src="TextGenerationSample.uss" />
    <ui:VisualElement name="root" class="app">
        <ui:VisualElement class="header">
            <ui:VisualElement class="brand">
                <ui:VisualElement class="logo">
                    <chat:ChatIcon icon-shape="Sparkle" class="logo__icon" />
                </ui:VisualElement>
                <ui:VisualElement>
                    <ui:Label text="Text Generation" class="brand__title" />
                    <ui:Label text="Runs on your device with Unity Inference Engine" class="brand__subtitle" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="header__actions">
                <ui:DropdownField name="model" class="model-picker" />
                <ui:Button name="clear" class="ghost-button">
                    <chat:ChatIcon icon-shape="NewChat" class="ghost-button__icon" />
                    <ui:Label text="New chat" class="ghost-button__label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="body">
            <ui:ScrollView name="messages" class="messages" mode="Vertical" horizontal-scroller-visibility="Hidden" mouse-wheel-scroll-size="60" />
            <ui:VisualElement name="empty" class="empty" picking-mode="Ignore">
                <ui:VisualElement class="empty__logo" picking-mode="Ignore">
                    <chat:ChatIcon icon-shape="Sparkle" class="empty__logo-icon" />
                </ui:VisualElement>
                <ui:Label text="What can I help with?" class="empty__title" picking-mode="Ignore" />
                <ui:Label name="emptyHint" class="empty__hint" picking-mode="Ignore" />
                <ui:VisualElement name="suggestions" class="suggestions" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="composer-area">
            <ui:VisualElement class="composer">
                <ui:TextField name="input" multiline="true" class="composer__input" />
                <ui:Button name="send" class="send-button">
                    <chat:ChatIcon name="sendIcon" icon-shape="Send" class="send-button__icon" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Label name="status" class="status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
