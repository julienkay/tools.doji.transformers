<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="TextGenerationSample.uss" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement class="header">
            <ui:VisualElement class="header__title">
                <ui:Label text="Text Generation" class="title" />
                <ui:Label text="Runs on your device with Unity Inference Engine" class="subtitle" />
            </ui:VisualElement>
            <ui:DropdownField name="model" class="model-picker" />
        </ui:VisualElement>
        <ui:ScrollView name="messages" class="messages" mode="Vertical" horizontal-scroller-visibility="Hidden">
            <ui:Label name="empty" text="Ask anything to start the chat." class="empty" />
        </ui:ScrollView>
        <ui:VisualElement class="composer">
            <ui:TextField name="input" multiline="true" class="composer__input" />
            <ui:Button name="send" text="Send" class="button button--primary" />
            <ui:Button name="clear" text="Clear" class="button" />
        </ui:VisualElement>
        <ui:Label name="status" class="status" />
    </ui:VisualElement>
</ui:UXML>
