:root {
    --bg: #0E1014;
    --surface: #161920;
    --surface-raised: #1F232B;
    --surface-hover: #272C36;
    --border: #2A2F39;
    --text: #E6E8EE;
    --text-muted: #8A91A0;
    --text-faint: #5D6371;
    --accent: #7C8CFF;
    --accent-hover: #97A4FF;
    --accent-soft: rgba(124, 140, 255, 0.16);
    --danger: #EF6B63;
    --column: 760px;
}

/* Layout */

.app {
    flex-grow: 1;
    background-color: var(--bg);
    color: var(--text);
    font-size: 15px;
}

.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 12px 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.brand {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    overflow: hidden;
}

.logo {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    flex-shrink: 0;
    border-radius: 10px;
    background-color: var(--accent-soft);
    align-items: center;
    justify-content: center;
}

.logo__icon {
    width: 18px;
    height: 18px;
    color: var(--accent);
}

.brand__title {
    font-size: 16px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.brand__subtitle {
    font-size: 12px;
    color: var(--text-muted);
    padding: 0;
    margin: 1px 0 0 0;
}

.header__actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 16px;
}

.body {
    flex-grow: 1;
    flex-shrink: 1;
}

.messages {
    flex-grow: 1;
}

.messages .unity-scroll-view__content-container {
    padding: 24px 20px 8px 20px;
}

/* Model picker */

.model-picker {
    margin: 0;
    min-width: 220px;
}

.model-picker > .unity-base-popup-field__input {
    height: 34px;
    padding: 0 10px 0 12px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 10px;
    background-color: var(--surface);
    color: var(--text);
    transition-duration: 0.15s;
}

.model-picker > .unity-base-popup-field__input:hover {
    background-color: var(--surface-raised);
}

.model-picker .unity-base-popup-field__text {
    color: var(--text);
    -unity-font-style: bold;
    font-size: 13px;
}

.model-picker .unity-base-popup-field__arrow {
    width: 16px;
    height: 16px;
    background-image: none;
}

.model-picker .chat-icon {
    flex-grow: 1;
    color: var(--text-muted);
}

/* The menu of the model picker. It opens at the root of the panel, so these rules come in through the theme. */

.unity-base-dropdown__container-outer {
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 10px;
}

.unity-base-dropdown__container-inner {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 4px;
}

.unity-base-dropdown__item {
    height: 32px;
    border-radius: 6px;
}

.unity-base-dropdown__item:hover {
    background-color: var(--surface-hover);
}

.unity-base-dropdown__label {
    color: var(--text);
    font-size: 13px;
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: var(--accent);
}

/* Buttons */

.ghost-button {
    flex-direction: row;
    align-items: center;
    height: 34px;
    margin: 0 0 0 8px;
    padding: 0 12px 0 8px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text);
    transition-duration: 0.15s;
}

.ghost-button:hover {
    background-color: var(--surface-raised);
}

.ghost-button:disabled {
    opacity: 0.4;
}

.ghost-button__icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
}

.ghost-button__label {
    font-size: 13px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

/* Empty state */

.empty {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 0 20px 40px 20px;
}

.empty.hidden {
    display: none;
}

.empty__logo {
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background-color: var(--accent-soft);
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
}

.empty__logo-icon {
    width: 28px;
    height: 28px;
    color: var(--accent);
}

.empty__title {
    font-size: 26px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.empty__hint {
    font-size: 14px;
    color: var(--text-muted);
    margin: 8px 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.suggestions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: var(--column);
    margin-top: 24px;
}

.suggestion {
    margin: 4px;
    padding: 9px 14px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 18px;
    background-color: var(--surface);
    color: var(--text-muted);
    font-size: 13px;
    transition-duration: 0.15s;
}

.suggestion:hover {
    background-color: var(--surface-raised);
    border-color: var(--text-faint);
    color: var(--text);
}

.suggestion:disabled {
    opacity: 0.4;
}

/* Messages */

.message {
    flex-direction: row;
    align-self: center;
    width: 100%;
    max-width: var(--column);
    margin-bottom: 20px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.message--enter {
    opacity: 0;
    translate: 0 10px;
}

.message--user {
    justify-content: flex-end;
}

.message__bubble {
    max-width: 80%;
    padding: 10px 16px;
    border-radius: 18px;
    border-bottom-right-radius: 6px;
    background-color: var(--surface-raised);
}

.message__avatar {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: 14px;
    border-radius: 14px;
    background-color: var(--accent-soft);
    align-items: center;
    justify-content: center;
}

.message__avatar-icon {
    width: 15px;
    height: 15px;
    color: var(--accent);
}

.message__body {
    flex-grow: 1;
    flex-shrink: 1;
    padding-top: 4px;
}

.message__text {
    padding: 0;
    margin: 0;
    white-space: normal;
    font-size: 15px;
    color: var(--text);
}

.message--pending .message__text {
    display: none;
}

.message--error .message__text {
    color: var(--danger);
}

.typing {
    flex-direction: row;
    height: 20px;
    align-items: center;
}

.typing__dot {
    width: 7px;
    height: 7px;
    margin-right: 5px;
    border-radius: 4px;
    background-color: var(--text-muted);
    opacity: 0.3;
    scale: 0.85 0.85;
    transition-property: opacity, scale;
    transition-duration: 0.25s;
}

.typing__dot--on {
    opacity: 1;
    scale: 1 1;
}

/* Scroll bar: thin, without arrows */

.messages .unity-scroller--vertical {
    width: 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.messages .unity-scroller__low-button,
.messages .unity-scroller__high-button {
    display: none;
}

.messages .unity-scroller--vertical > .unity-scroller__slider {
    margin: 4px 0;
}

.messages .unity-base-slider__tracker,
.messages .unity-base-slider__dragger-border {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.messages .unity-base-slider__dragger {
    left: 2px;
    right: 2px;
    width: auto;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.12);
}

.messages .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.22);
}

/* Composer */

.composer-area {
    flex-shrink: 0;
    padding: 8px 20px 10px 20px;
}

.composer {
    flex-direction: row;
    align-items: flex-end;
    align-self: center;
    width: 100%;
    max-width: var(--column);
    padding: 8px 8px 8px 16px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 22px;
    transition-duration: 0.15s;
}

.composer--focused {
    border-color: var(--text-faint);
}

.composer__input {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 8px 0 0;
}

.composer__input > .unity-base-text-field__input {
    min-height: 36px;
    max-height: 180px;
    padding: 8px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text);
    font-size: 15px;
    white-space: normal;
    --unity-cursor-color: var(--accent);
    --unity-selection-color: rgba(124, 140, 255, 0.35);
}

.composer__input > .unity-base-text-field__input--placeholder,
.composer__input > .unity-base-text-field__input--placeholder > .unity-text-element {
    color: var(--text-faint);
}

.send-button {
    width: 36px;
    height: 36px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 18px;
    background-color: var(--accent);
    color: #FFFFFF;
    align-items: center;
    justify-content: center;
    transition-duration: 0.15s;
}

.send-button:hover {
    background-color: var(--accent-hover);
}

.send-button:disabled {
    background-color: var(--surface-hover);
    color: var(--text-faint);
    opacity: 1;
}

.send-button--stop {
    background-color: var(--text);
    color: var(--bg);
}

.send-button--stop:hover {
    background-color: #FFFFFF;
}

.send-button__icon {
    width: 20px;
    height: 20px;
}

.status {
    align-self: center;
    margin-top: 8px;
    padding: 0;
    font-size: 12px;
    color: var(--text-faint);
    -unity-text-align: middle-center;
}
